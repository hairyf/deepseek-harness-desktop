    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.6.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "bumpp": "12.2.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "knip": "^6.32.2",
    "tailwindcss": "4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"

    "typecheck": "tsc --noEmit",
    "icons": "tauri icon public/favicon.svg"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.21.0",
    "@hairy/react-lib": "^1.52.0",
    "@hairy/utils": "^1.52.0",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@overlastic/react": "^0.9.0",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-if-lite": "^0.1.0",
    "react-use": "^17.6.1",
